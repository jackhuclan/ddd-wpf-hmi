<Window x:Class="Hmi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工控设备监控上位机"
        Height="760" Width="1180" MinHeight="680" MinWidth="1024"
        FontFamily="Microsoft YaHei, Segoe UI" FontSize="12"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧深色导航 -->
            <Border Grid.Column="0" Background="{StaticResource NavBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="96"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,14,10,0">
                        <Border Width="34" Height="34" CornerRadius="4" HorizontalAlignment="Left"
                                Background="#FF2E6BB8">
                            <TextBlock Text="HMI" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="工控设备监控上位机" Foreground="#FFB8C2CC" FontSize="11"
                                   Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="MainNavigation"
                                             Style="{StaticResource NavRadioStyle}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding Key}">
                                    <RadioButton.Content>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </RadioButton.Content>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="20,16,20,12"/>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Background="{StaticResource NavBackground}" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="11" Foreground="#FFD0D8E0" VerticalAlignment="Center"
                           Text="{Binding CurrentPageTitle, StringFormat=当前页：{0}}"/>
                <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="11" Foreground="#FF9FB0C0"
                           VerticalAlignment="Center" Text="{Binding ArchitectureText}"/>
                <TextBlock Grid.Column="2" Margin="18,0,0,0" FontSize="11" Foreground="#FF8092A6"
                           VerticalAlignment="Center" Text="{Binding StatusTip}" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource RedDot}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource GreenDot}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#FFD0D8E0"
                               VerticalAlignment="Center" Text="{Binding ConnectionText}"/>
                </StackPanel>

                <TextBlock Grid.Column="4" FontSize="11" Foreground="#FFD0D8E0"
                           VerticalAlignment="Center" Text="{Binding ClockText}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
