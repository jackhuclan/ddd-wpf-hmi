<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 取自原文截图的配色 -->
    <SolidColorBrush x:Key="NavBackground" Color="#FF1E2633"/>
    <SolidColorBrush x:Key="NavSelected" Color="#FF2B3A4D"/>
    <SolidColorBrush x:Key="NavHover" Color="#FF263242"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#FF4A90E2"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1F2329"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF606971"/>
    <SolidColorBrush x:Key="LinkBlue" Color="#FF0066CC"/>
    <SolidColorBrush x:Key="GridBorder" Color="#FFD5DEE7"/>
    <SolidColorBrush x:Key="GridLine" Color="#FFE8EDF2"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#FFF7F9FB"/>
    <SolidColorBrush x:Key="GreenDot" Color="#FF52C41A"/>
    <SolidColorBrush x:Key="RedDot" Color="#FFF5222D"/>

    <Style TargetType="Button">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource LinkBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GridBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="White"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="ColumnHeaderHeight" Value="26"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource HeaderBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource GridBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 左侧深色导航项 -->
    <Style x:Key="NavRadioStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#FFC8D2DC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" Width="18" FontSize="12"
                                           Foreground="#FF9FB0C0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelected}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentBlue}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
