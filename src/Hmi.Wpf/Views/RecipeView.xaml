<UserControl x:Class="Hmi.Wpf.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <TextBlock Text="配方管理 (Recipe 上下文 • 配置驱动)" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <Button Content="刷新（重载配置）" HorizontalAlignment="Right" MinWidth="130"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Recipes}"
                  SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Code}" Width="180"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="120"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"/>
            <Button Content="切换下发（激活）" HorizontalAlignment="Right" MinWidth="130"
                    Command="{Binding SwitchCommand}"/>
        </Grid>
    </Grid>
</UserControl>
