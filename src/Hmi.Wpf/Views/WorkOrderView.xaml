<UserControl x:Class="Hmi.Wpf.Views.WorkOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="工单管理 (WorkOrder 上下文)" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <Button Content="刷新" HorizontalAlignment="Right" MinWidth="70"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
            <TextBlock Text="工单号:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
            <TextBox Width="200" Margin="4,0,0,0" Text="{Binding NewOrderCode, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="创建工单" Margin="8,0,0,0" MinWidth="76" Command="{Binding CreateCommand}"/>

            <TextBlock Text="设备:" Margin="20,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
            <ComboBox Width="150" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="配方编号:" Margin="20,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
            <TextBox Width="110" Text="{Binding RecipeCodeInput, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="指派设备" Margin="8,0,0,0" MinWidth="76" Command="{Binding AssignCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="工单号" Binding="{Binding Code}" Width="220"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="配方" Binding="{Binding RecipeCode}" Width="140"/>
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="开始执行" MinWidth="76" Command="{Binding StartCommand}"/>
                <Button Content="完成（归档）" Margin="8,0,0,0" MinWidth="96" Command="{Binding CompleteCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
